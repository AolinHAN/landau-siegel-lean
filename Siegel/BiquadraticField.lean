import Siegel.BiquadraticFieldDegree

/-! # The four automorphisms of the actual biquadratic field

The field is the intermediate field of complex numbers generated by the two
radicals. Its automorphisms are classified by their two signs; no normality
or Galois hypothesis is assumed.
-/

namespace Siegel.Biquadratic

noncomputable abbrev Extension (a b : ℂ) := IntermediateField.adjoin ℚ ({a, b} : Set ℂ)

noncomputable def fieldGenA (a b : ℂ) : Extension a b := IntermediateField.AdjoinPair.gen₁ ℚ a b
noncomputable def fieldGenB (a b : ℂ) : Extension a b := IntermediateField.AdjoinPair.gen₂ ℚ a b

/-- An automorphism is determined by the two radical generators. -/
theorem fieldAut_ext (a b : ℂ) (φ ψ : Extension a b ≃ₐ[ℚ] Extension a b)
    (ha : φ (fieldGenA a b) = ψ (fieldGenA a b))
    (hb : φ (fieldGenB a b) = ψ (fieldGenB a b)) : φ = ψ := by
  have h : φ.toAlgHom = ψ.toAlgHom := by
    apply IntermediateField.adjoin_algHom_ext ℚ
    intro z hz
    rcases Set.mem_insert_iff.mp hz with rfl | hz
    · exact ha
    · have he : z = b := Set.mem_singleton_iff.mp hz
      subst z
      exact hb
  apply AlgEquiv.ext
  intro z
  exact congrArg (fun e : Extension a b →ₐ[ℚ] Extension a b => e z) h

/-- The first generator can only map to itself or its negative. -/
theorem fieldAut_genA_cases (d : ℤ) (a b : ℂ) (ha : a ^ 2 = (d : ℂ))
    (φ : Extension a b ≃ₐ[ℚ] Extension a b) :
    φ (fieldGenA a b) = fieldGenA a b ∨ φ (fieldGenA a b) = -fieldGenA a b := by
  have hsq : fieldGenA a b ^ 2 = (d : Extension a b) := by
    apply Subtype.ext
    exact ha
  apply sq_eq_sq_iff_eq_or_eq_neg.mp
  rw [← map_pow, hsq, map_intCast]

/-- The second generator can only map to itself or its negative. -/
theorem fieldAut_genB_cases (a b : ℂ) (hb : b ^ 2 = 2)
    (φ : Extension a b ≃ₐ[ℚ] Extension a b) :
    φ (fieldGenB a b) = fieldGenB a b ∨ φ (fieldGenB a b) = -fieldGenB a b := by
  have hsq : fieldGenB a b ^ 2 = (2 : Extension a b) := by
    apply Subtype.ext
    exact hb
  apply sq_eq_sq_iff_eq_or_eq_neg.mp
  rw [← map_pow, hsq, map_ofNat]

/-- `false` records the positive sign, and `true` the negative sign. -/
noncomputable def fieldAutSigns (a b : ℂ)
    (φ : Extension a b ≃ₐ[ℚ] Extension a b) : Bool × Bool := by
  classical
  exact (if φ (fieldGenA a b) = fieldGenA a b then false else true,
    if φ (fieldGenB a b) = fieldGenB a b then false else true)

theorem fieldAut_genA_eq_sign (d : ℤ) (a b : ℂ) (ha : a ^ 2 = (d : ℂ))
    (φ : Extension a b ≃ₐ[ℚ] Extension a b) :
    φ (fieldGenA a b) = if (fieldAutSigns a b φ).1 then -fieldGenA a b else fieldGenA a b := by
  classical
  by_cases h : φ (fieldGenA a b) = fieldGenA a b
  · simp [fieldAutSigns, h]
  · simpa [fieldAutSigns, h] using (fieldAut_genA_cases d a b ha φ).resolve_left h

theorem fieldAut_genB_eq_sign (a b : ℂ) (hb : b ^ 2 = 2)
    (φ : Extension a b ≃ₐ[ℚ] Extension a b) :
    φ (fieldGenB a b) = if (fieldAutSigns a b φ).2 then -fieldGenB a b else fieldGenB a b := by
  classical
  by_cases h : φ (fieldGenB a b) = fieldGenB a b
  · simp [fieldAutSigns, h]
  · simpa [fieldAutSigns, h] using (fieldAut_genB_cases a b hb φ).resolve_left h

/-- The pair of signs faithfully encodes each automorphism. -/
theorem fieldAutSigns_injective (d : ℤ) (a b : ℂ)
    (ha : a ^ 2 = (d : ℂ)) (hb : b ^ 2 = 2) :
    Function.Injective (fieldAutSigns a b) := by
  intro φ ψ h
  apply fieldAut_ext
  · rw [fieldAut_genA_eq_sign d a b ha φ, fieldAut_genA_eq_sign d a b ha ψ, h]
  · rw [fieldAut_genB_eq_sign a b hb φ, fieldAut_genB_eq_sign a b hb ψ, h]

/-- All four sign choices occur, because the actual Galois group has order four. -/
theorem fieldAutSigns_bijective (d : ℤ) (a b : ℂ)
    (ha : a ^ 2 = (d : ℂ)) (hb : b ^ 2 = 2)
    (hlin : LinearIndependent ℚ ![1, a, b, a * b]) :
    Function.Bijective (fieldAutSigns a b) := by
  apply (fieldAutSigns_injective d a b ha hb).bijective_of_nat_card_le
  rw [field_card_aut d a b ha hb hlin]
  norm_num [Nat.card_eq_fintype_card]

/-- The concrete Galois generators from Section 4: `σ` negates only `a`,
`τ` negates only `b`, both are involutions, they commute, and the four
possibilities `1, σ, τ, στ` exhaust the automorphism group. -/
theorem exists_field_automorphisms (d : ℤ) (a b : ℂ)
    (ha : a ^ 2 = (d : ℂ)) (hb : b ^ 2 = 2)
    (hlin : LinearIndependent ℚ ![1, a, b, a * b]) :
    ∃ σ τ : Extension a b ≃ₐ[ℚ] Extension a b,
      σ (fieldGenA a b) = -fieldGenA a b ∧ σ (fieldGenB a b) = fieldGenB a b ∧
      τ (fieldGenA a b) = fieldGenA a b ∧ τ (fieldGenB a b) = -fieldGenB a b ∧
      σ ^ 2 = 1 ∧ τ ^ 2 = 1 ∧ σ * τ = τ * σ ∧
      ∀ φ : Extension a b ≃ₐ[ℚ] Extension a b,
        φ = 1 ∨ φ = σ ∨ φ = τ ∨ φ = σ * τ := by
  obtain ⟨σ, hσ⟩ := (fieldAutSigns_bijective d a b ha hb hlin).surjective (true, false)
  obtain ⟨τ, hτ⟩ := (fieldAutSigns_bijective d a b ha hb hlin).surjective (false, true)
  have hσa : σ (fieldGenA a b) = -fieldGenA a b := by
    simpa [hσ] using fieldAut_genA_eq_sign d a b ha σ
  have hσb : σ (fieldGenB a b) = fieldGenB a b := by
    simpa [hσ] using fieldAut_genB_eq_sign a b hb σ
  have hτa : τ (fieldGenA a b) = fieldGenA a b := by
    simpa [hτ] using fieldAut_genA_eq_sign d a b ha τ
  have hτb : τ (fieldGenB a b) = -fieldGenB a b := by
    simpa [hτ] using fieldAut_genB_eq_sign a b hb τ
  refine ⟨σ, τ, hσa, hσb, hτa, hτb, ?_, ?_, ?_, ?_⟩
  · apply fieldAut_ext <;> simp [pow_two, hσa, hσb]
  · apply fieldAut_ext <;> simp [pow_two, hτa, hτb]
  · apply fieldAut_ext <;> simp [hσa, hσb, hτa, hτb]
  · intro φ
    rcases fieldAut_genA_cases d a b ha φ with hφa | hφa <;>
      rcases fieldAut_genB_cases a b hb φ with hφb | hφb
    · left
      apply fieldAut_ext
      · simpa using hφa
      · simpa using hφb
    · right; right; left
      apply fieldAut_ext
      · exact hφa.trans hτa.symm
      · exact hφb.trans hτb.symm
    · right; left
      apply fieldAut_ext
      · exact hφa.trans hσa.symm
      · exact hφb.trans hσb.symm
    · right; right; right
      apply fieldAut_ext <;> simp [hφa, hφb, hσa, hσb, hτa, hτb]

end Siegel.Biquadratic
